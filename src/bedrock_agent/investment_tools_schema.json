{
  "openapi": "3.0.0",
  "info": {
    "title": "Investment Analysis Tools",
    "version": "1.0.0",
    "description": "API for investment analysis and financial data retrieval"
  },
  "paths": {
    "/analyze_investment": {
      "post": {
        "summary": "Analyze investment for a given stock ticker",
        "description": "Performs comprehensive investment analysis including financial metrics, recommendations, and insights",
        "operationId": "analyze_investment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ticker": {
                    "type": "string",
                    "description": "Stock ticker symbol (e.g., AAPL, MSFT, GOOGL)",
                    "example": "AAPL"
                  },
                  "depth": {
                    "type": "string",
                    "description": "Analysis depth level",
                    "enum": ["quick", "standard", "detailed"],
                    "default": "standard"
                  }
                },
                "required": ["ticker"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Investment analysis completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "analysis": {
                      "type": "string",
                      "description": "Formatted investment analysis with recommendations"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_financial_data": {
      "post": {
        "summary": "Get financial data for a stock ticker",
        "description": "Retrieves basic financial data and metrics for a company",
        "operationId": "get_financial_data",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ticker": {
                    "type": "string",
                    "description": "Stock ticker symbol",
                    "example": "AAPL"
                  },
                  "data_type": {
                    "type": "string",
                    "description": "Type of financial data to retrieve",
                    "enum": ["overview", "metrics", "earnings"],
                    "default": "overview"
                  }
                },
                "required": ["ticker"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Financial data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "description": "Formatted financial data"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_trade_history": {
      "post": {
        "summary": "Get trade history for a user",
        "description": "Retrieves trade history data for investment analysis and reporting",
        "operationId": "get_trade_history",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query_type": {
                    "type": "string",
                    "description": "Type of trade history query",
                    "enum": ["allTrades"],
                    "default": "allTrades"
                  },
                  "time_frame": {
                    "type": "string",
                    "description": "Time frame for the trade history",
                    "enum": ["this year", "last month", "last quarter", "last 6 months"],
                    "default": "this year"
                  },
                  "user_id": {
                    "type": "string",
                    "description": "User identifier for trade history",
                    "default": "mock_ic_user_1"
                  }
                },
                "required": ["query_type"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trade history retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "trades": {
                      "type": "array",
                      "description": "List of trade records"
                    },
                    "summary": {
                      "type": "object",
                      "description": "Summary statistics of trades"
                    },
                    "message": {
                      "type": "string",
                      "description": "Success message"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
} 